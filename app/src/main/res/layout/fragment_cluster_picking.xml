<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgCard"
    android:clickable="true"
    tools:context=".dc.ClusterPickingFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/cluster_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cluster"
                android:textColor="#000"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/cluster_select"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@color/colorAccent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Packing material"
                android:textColor="#000"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/cluster_pack"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@color/colorAccent" />

            <Button
                android:id="@+id/cluster_load"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#e71821"
                android:text="Load cluster"
                android:textColor="#fff" />
        </LinearLayout>

        <TextView
            android:id="@+id/cluster_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Choose a cluster"
            android:textColor="#000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/cluster_scan"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="#fff"
            android:hint="Scan"
            android:imeOptions="actionDone"
            android:inputType="textNoSuggestions"
            android:paddingStart="8dp"
            android:singleLine="true"
            android:textColor="#000"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/cluster_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#000"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/cluster_slots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textColor="#000"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cluster_back"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="#e71821"
                android:text="Back"
                android:textColor="#fff" />

            <Button
                android:id="@+id/cluster_short"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="#e71821"
                android:text="Bin short"
                android:textColor="#fff"
                android:visibility="gone" />

            <Button
                android:id="@+id/cluster_retry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="#e71821"
                android:text="Retry save"
                android:textColor="#fff"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
